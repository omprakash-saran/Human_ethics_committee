# Node.js .gitignore

# Logs
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.log
*.lock

# Node.js dependencies
node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swm

# Build output
dist/
build/

# Test coverage
coverage/
